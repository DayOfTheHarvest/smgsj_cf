{
  "name": "smgsj-parish",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "python3 scripts/check-pins.py && python3 scripts/sync-icons.py && python3 scripts/sync-shortcuts.py && python3 scripts/sync-preview.py && astro build && python3 scripts/sitemap.py && npm run pagefind",
    "build:astro": "astro build",
    "pagefind": "pagefind --site dist 2>&1 | tail -n 5 || echo 'pagefind skipped (offline?)'",
    "preview": "astro preview --host",
    "migrate": "python3 scripts/migrate.py",
    "auth:check": "python3 scripts/check-auth.py",
    "content:check": "python3 scripts/check-slugs.py"
  },
  "dependencies": {
    "astro": "^4.16.0",
    "marked": "^18.0.14"
  },
  "devDependencies": {
    "@astrojs/tailwind": "^5.1.5",
    "pagefind": "1.3.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.5.0",
    "wrangler": "4.86.0"
  },
  "engines": {
    "node": ">=20"
  }
}
