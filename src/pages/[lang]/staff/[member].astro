---
import Base from '../../../layouts/Base.astro';
import staffEn from '../../../data/staff.en.json';
import staffEs from '../../../data/staff.es.json';
import staffVi from '../../../data/staff.vi.json';
import { pickLocale } from '../../../lib/i18n';
import type { Lang } from '../../../config';
import en from '../../../data/ui.en.json';
import es from '../../../data/ui.es.json';
import vi from '../../../data/ui.vi.json';

export async function getStaticPaths() {
  const members = (staffEn as any).members as Array<{ slug: string }>;
  const langs: Lang[] = ['en', 'es', 'vi'];
  return members.flatMap((m) => langs.map((lang) => ({ params: { lang, member: m.slug } })));
}
const { lang, member } = Astro.params as { lang: Lang; member: string };
const ui = lang === 'es' ? es : lang === 'vi' ? vi : en;
const members = ((pickLocale({ en: staffEn, es: staffEs, vi: staffVi }, lang) as any).members as Array<{
  slug: string; name: string; role: string; phone: string; photo: string; bio: string;
}>);
const person = members.find((m) => m.slug === member);
if (!person) return Astro.redirect(`/${lang}/staff/`, 404);
---
<Base lang={lang} slug="staff" title={person.name}>
  <p><a href={`/${lang}/staff/`}>← {ui.staffTitle}</a></p>
  <h1>{person.name}</h1>
  <p class="text-soft"><strong>{person.role}</strong></p>
  {person.photo && <img src={person.photo} alt={person.name} width="240" loading="lazy" style="border-radius:.75rem" />}
  <p>{ui.phoneLabel}: <a href={`tel:${person.phone.replace(/[^0-9]/g, '')}`}>{person.phone}</a></p>
  {person.bio && <article class="prose" data-pagefind-body><p>{person.bio}</p></article>}
</Base>
