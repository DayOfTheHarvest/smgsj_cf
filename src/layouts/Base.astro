---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import noticeEn from '../data/notice.en.json';
import noticeEs from '../data/notice.es.json';
import noticeVi from '../data/notice.vi.json';
import { pickLocale } from '../lib/i18n';
import '../styles/global.css';
import type { Lang } from '../config';
import { SITE_NAME, resolveLink } from '../config';
import en from '../data/ui.en.json';
import es from '../data/ui.es.json';
import vi from '../data/ui.vi.json';

interface Props {
  lang: Lang;
  slug: string;
  title: string;
  description?: string;
  fallback?: boolean;
  /** Full canonical path override (the homepage served at / uses '/'). */
  canonicalPath?: string;
}
const { lang, slug, title, description, fallback = false, canonicalPath } = Astro.props;
const ui = lang === 'es' ? es : lang === 'vi' ? vi : en;
const base = import.meta.env.SITE ?? 'https://www.smgsj.org';
const canonical = `${base}${canonicalPath ?? `/${lang}${slug && slug !== 'home' ? '/' + slug : ''}`}`;
const notice = pickLocale({ en: noticeEn, es: noticeEs, vi: noticeVi }, lang) as any;
const noticeText: string = (notice.text || '').trim();
const noticeLabel: string = (notice.link_label || '').trim();
// Parish-page links gain the viewing language (/mass-times/ -> /en/...);
// dangerous schemes resolve to '#' and are hidden outright.
const noticeHref = resolveLink(notice.link || '', lang);
const showNoticeLink = Boolean((notice.link || '').trim()) && noticeHref !== '#';
const showNotice = Boolean(notice.enabled) && noticeText.length > 0;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} | {SITE_NAME}</title>
  {description && <meta name="description" content={description} />}
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="en" href={`${base}/en${slug && slug !== 'home' ? '/' + slug : ''}`} />
  <link rel="alternate" hreflang="es" href={`${base}/es${slug && slug !== 'home' ? '/' + slug : ''}`} />
  <link rel="alternate" hreflang="vi" href={`${base}/vi${slug && slug !== 'home' ? '/' + slug : ''}`} />
  <link rel="alternate" hreflang="x-default" href={`${base}/`} />
  <link rel="icon" href="/favicon.ico" />
  <!-- No visitor stats yet (old GA UA-135786317-1 is dead): when analytics is
       decided, paste the real snippet here. See DEPLOY.md. Nothing loads until then. -->
</head>
<body>
  <a class="skip" href="#main">{ui.skipLink}</a>
  <Header lang={lang} slug={slug} ui={ui} />
  {showNotice && (
    <div class="notice" role="alert">
      <div class="wrap">
        <strong>{noticeText}</strong>
        {showNoticeLink ? <> <a href={noticeHref}>{noticeLabel || noticeHref}</a></> : null}
      </div>
    </div>
  )}
  <main id="main" class="wrap">
    {fallback && <div class="fallback" data-fallback="en" role="note">{ui.fallbackBanner}</div>}
    <slot />
  </main>
  <Footer lang={lang} ui={ui} />
</body>
</html>
