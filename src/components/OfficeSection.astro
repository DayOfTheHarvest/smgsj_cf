---
import { OFFICE_HOURS } from '../data/mass';
import { PHONE, EMAIL, EMERGENCIES, emergencyLabel } from '../config';
import Icon from './Icon.astro';
import type { Lang } from '../config';
interface Props { lang: Lang; ui: any; }
const { lang, ui } = Astro.props;
const tel = (n: string) => (n || '').replace(/[^0-9]/g, '');
const hours = (OFFICE_HOURS[lang] || OFFICE_HOURS.en).split('\n').map((line) => {
  const i = line.indexOf(':');
  return i > 0
    ? { days: line.slice(0, i).trim(), time: line.slice(i + 1).trim() }
    : { days: line.trim(), time: '' };
});
---
<section aria-label={ui.contactSection}>
  <h2>{ui.contactSection}</h2>
  <div class="cards">
    <article class="card">
      <div class="card-head"><Icon name="clock" /><h3>{ui.schedule.office}</h3></div>
      <dl class="my-2">
        {hours.map((r) => (
          <div class="border-b border-line py-2 last:border-0">
            <dt class="font-bold text-navy">{r.days}</dt>
            {r.time ? <dd class="m-0">{r.time}</dd> : null}
          </div>
        ))}
      </dl>
    </article>
    <article class="card">
      <div class="card-head"><Icon name="alert" /><h3>{ui.footer.emergency}</h3></div>
      <dl class="my-2">
        {EMERGENCIES.map((e, i) => (
          <div class={i < EMERGENCIES.length - 1 ? 'border-b border-line py-2' : 'py-2'}>
            <dt class="font-bold text-navy">{emergencyLabel(e, lang)}</dt>
            <dd class="m-0"><a class="font-bold" href={`tel:${tel(e.number)}`}>{e.number}</a></dd>
          </div>
        ))}
      </dl>
    </article>
    <article class="card">
      <div class="card-head"><Icon name="phone" /><h3>{ui.contactCard}</h3></div>
      <p class="font-serif text-2xl font-bold"><a class="text-navy no-underline" href={`tel:${tel(PHONE)}`}>{PHONE}</a></p>
      <p class="text-lg font-bold"><a class="text-navy" href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
    </article>
  </div>
</section>
