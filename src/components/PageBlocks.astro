---
import FundraiserProgress from './FundraiserProgress.astro';
import { resolveLink, type Lang } from '../config';
import { renderMd } from '../lib/md';

interface Props {
  lang: Lang;
  ui: any;
  title: string;
  blocks?: Array<any>;
  sections?: Array<any>;
}
const { lang, ui, title, blocks = [], sections = [] } = Astro.props;

const btnClassFor = (s: string) =>
  s === 'gold' ? 'btn btn-gold' : s === 'primary' ? 'btn btn-primary' : s === 'outline' ? 'btn btn-outline' : 'btn btn-light';
const hrefFor = (link: string) => resolveLink(link || '', lang);
// Render Markdown in frontmatter (existing pattern: set:html takes a variable,
// never a function call in the template).
const withHtml = (list: Array<any>) =>
  (Array.isArray(list) ? list : []).map((b) => ({
    ...b,
    __html: b?.body?.trim() ? renderMd(b.body) : '',
  }));
const blocksR = withHtml(blocks);
const sectionsR = (Array.isArray(sections) ? sections : []).map((s) => ({
  ...s,
  __html: s?.body?.trim() ? renderMd(s.body) : '',
  blocks: withHtml(s?.blocks),
}));
---

{blocksR.map((b) => (
  <>
    {b?.type === 'fundraiser' && <FundraiserProgress ui={ui} title={title} fundraiser={b} />}
    {b?.type === 'embed' && b?.url?.trim() && (
      <section aria-label={b.title?.trim() || title}>
        {b.title?.trim() && <h2>{b.title}</h2>}
        <div class="table-scroll" style="border:0">
          <iframe src={b.url.trim()} title={b.title?.trim() || title} width="100%" height={Number(b.height) || 1000} loading="lazy"></iframe>
        </div>
        {b.caption?.trim() && <p class="text-sm text-soft">{b.caption}</p>}
      </section>
    )}
    {b?.type === 'button' && b?.label?.trim() && b?.link?.trim() && (
      <p><a class={btnClassFor(b.style || 'light')} href={hrefFor(b.link.trim())}>{b.label}</a></p>
    )}
    {b?.type === 'richtext' && b.__html && (
      <div class="prose" set:html={b.__html} />
    )}
    {b?.type === 'image' && b?.image?.trim() && (
      <p><img src={b.image} alt={b.alt || ''} loading="lazy" style="border-radius:.75rem" /></p>
    )}
  </>
))}
{sectionsR.map((s) => (
  <section aria-label={s?.title?.trim() || title} class={s?.type === 'fullwidth_section' ? 'fullwidth' : ''}>
    {s?.title?.trim() && <h2>{s.title}</h2>}
    {s.__html && <div class="prose" set:html={s.__html} />}
    {s.blocks.map((b) => (
      <>
        {b?.type === 'fundraiser' && <FundraiserProgress ui={ui} title={s?.title?.trim() || title} fundraiser={b} />}
        {b?.type === 'embed' && b?.url?.trim() && (
          <div>
            {b.title?.trim() && <h3>{b.title}</h3>}
            <div class="table-scroll" style="border:0">
              <iframe src={b.url.trim()} title={b.title?.trim() || s?.title || title} width="100%" height={Number(b.height) || 1000} loading="lazy"></iframe>
            </div>
            {b.caption?.trim() && <p class="text-sm text-soft">{b.caption}</p>}
          </div>
        )}
        {b?.type === 'button' && b?.label?.trim() && b?.link?.trim() && (
          <p><a class={btnClassFor(b.style || 'light')} href={hrefFor(b.link.trim())}>{b.label}</a></p>
        )}
        {b?.type === 'richtext' && b.__html && (
          <div class="prose" set:html={b.__html} />
        )}
        {b?.type === 'image' && b?.image?.trim() && (
          <p><img src={b.image} alt={b.alt || ''} loading="lazy" style="border-radius:.75rem" /></p>
        )}
      </>
    ))}
  </section>
))}
