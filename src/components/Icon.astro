---
// Inline SVG line icons (Feather-style, MIT). Crisp at every size, inherit
// text color, no emoji variation across phones. Usage: <Icon name="news" />
// Paths live in src/lib/icons.js, shared with the CMS preview renderer.
import { ICON_PATHS } from '../lib/icons.js';
interface Props { name: string; size?: number; }
const { name, size = 26 } = Astro.props;
---
<span class="icon-badge" aria-hidden="true"><svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ICON_PATHS[name] ?? ICON_PATHS.info} /></span>
