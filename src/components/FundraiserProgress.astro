---
interface Props {
  ui: any;
  title: string;
  fundraiser: any;
}
const { ui, title, fundraiser: f } = Astro.props;
// Thermometer added as a page widget (Pages → Page widgets → Fundraiser).
// Numbers/links are shared across languages; only title and button label
// translate (missing translations fall back to English when merged).
const goal: number = Number(f?.goal) || 0;
const pledged: number = Number(f?.pledged) || 0;
const pct = goal > 0 ? Math.min(100, (pledged / goal) * 100) : 0;
const fmt = (n: number) => n.toLocaleString('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: n % 1 ? 2 : 0 });
const label = (f?.donate_label as string)?.trim() || ui.nav.giving;
const ariaTitle = (f?.title as string)?.trim() || title;
// NOTE: centering is set via Tailwind class AND inline style on every row.
// Keep both: the class documents intent, the inline style wins over any
// stylesheet interference (stale caches, extensions) in the visitor's browser.
// max-w-none matters too: the global p{max-width:70ch} readability rule would
// otherwise narrow these rows and left-align their boxes (text centers within
// the narrowed box, not the widget) — exactly the bug this guards against.
const centerStyle = 'text-align:center';
---
{(f && goal > 0) && (
  <section class="my-6 rounded-xl border border-line bg-muted p-5 text-center" style={centerStyle} aria-label={ariaTitle}>
    <p class="my-1 max-w-none text-center text-sm font-bold uppercase tracking-widest text-soft" style={centerStyle}>{ui.pledgedAsOf}{' '}{f.updated}</p>
    <p class="my-1 max-w-none text-center font-serif text-4xl font-bold text-navy" style={centerStyle}>{fmt(pledged)}</p>
    <div class="mx-auto my-3 h-5 max-w-xl overflow-hidden rounded-full bg-white" role="progressbar"
         aria-valuenow={Math.round(pct * 100) / 100} aria-valuemin={0} aria-valuemax={100}
         aria-label={`${fmt(pledged)} ${ui.ofWord} ${fmt(goal)} ${ui.goalWord}`}>
      <div class="h-full rounded-full" style={`width:${pct.toFixed(2)}%;background:linear-gradient(90deg,#a8861c,#c9a227)`}></div>
    </div>
    <p class="my-1 max-w-none text-center font-bold text-navy" style={centerStyle}>{pct.toFixed(2)}%{' '}{ui.ofWord}{' '}{fmt(goal)}{' '}{ui.goalWord}</p>
    {f.donate_link?.trim() ? (
      <p class="max-w-none text-center" style={centerStyle}><a class="btn btn-gold" href={f.donate_link.trim()}>{label}</a></p>
    ) : null}
  </section>
)}
