---
import Base from '../layouts/Base.astro';
import Carousel from './Carousel.astro';
import Icon from './Icon.astro';
import FlocknoteSignup from './FlocknoteSignup.astro';
import MassCards from './MassCards.astro';
import { EXTERNAL, resolveLink, type Lang, PHONE, EMAIL, EMERGENCIES, emergencyLabel } from '../config';
import homepageEn from '../data/homepage.en.json';
import homepageEs from '../data/homepage.es.json';
import homepageVi from '../data/homepage.vi.json';
import bulletinEn from '../data/bulletins.en.json';
import bulletinEs from '../data/bulletins.es.json';
import bulletinVi from '../data/bulletins.vi.json';
import { OFFICE_HOURS } from '../data/mass';
import { pickLocale } from '../lib/i18n';
import { renderMd } from '../lib/md';
import { renderSections } from '../lib/render-blocks.js';
import { btnClassFor, esc } from '../lib/render-blocks.js';
import staffEn from '../data/staff.en.json';
import staffEs from '../data/staff.es.json';
import staffVi from '../data/staff.vi.json';
import en from '../data/ui.en.json';
import es from '../data/ui.es.json';
import vi from '../data/ui.vi.json';

interface Props {
  lang: Lang;
  home: { slug: string; en: any; es?: any; vi?: any } | undefined;
  /** Rendered at site root: canonical points to / instead of /en. */
  isRoot?: boolean;
}
const { lang, home: bundle, isRoot = false } = Astro.props;
const ui = lang === 'es' ? es : lang === 'vi' ? vi : en;
// Homepage copy falls back per-field exactly like topic pages do.
const homeEn = bundle?.en;
const homeLoc = (bundle as any)?.[lang] ?? homeEn;
const bodyEn = homeEn?.body ?? '';
const bodyLoc = (homeLoc?.body as string)?.trim();
const fallback = lang !== 'en' && !bodyLoc;
const body = renderMd(lang === 'en' ? bodyEn : (bodyLoc || bodyEn));
const titleVal = (homeLoc?.data?.title as string)?.trim()
  || homeEn?.data?.title || ui.hero.welcome;
const homepage = pickLocale({ en: homepageEn, es: homepageEs, vi: homepageVi }, lang) as any;
// Section config lives inside each row (CMS: Homepage Welcome & Events).
// Lookups take the first row of each type; the render loop below uses the
// row it is rendering so repeated rows each show their own content.
const sections = (homepage.sections as Array<any>) ?? [];
// Button colors come from the shared renderer (single implementation with
// the CMS preview) — no local copy to drift.
const hrefFor = (link: string) => resolveLink(link, lang);
// Generic content blocks (events extras, custom rows) render with the same
// shared renderer as Pages sections: same widgets, same markup.
const staffMembers = ((pickLocale({ en: staffEn, es: staffEs, vi: staffVi }, lang) as any).members as Array<any>) ?? [];
const blockOpts = (title: string) => ({
  title,
  lang,
  md: (src: string) => renderMd(src || ''),
  href: (link: string) => resolveLink(link || '', lang),
  assetUrl: (p: string) => p,
  t: {
    asof: ui.pledgedAsOf,
    of: ui.ofWord,
    goal: ui.goalWord,
    donate: ui.nav.giving,
  },
  bulletins: {
    items: (((pickLocale({ en: bulletinEn, es: bulletinEs, vi: bulletinVi }, lang) as any).bulletins) as Array<any>) ?? [],
    weeks: Number((pickLocale({ en: bulletinEn, es: bulletinEs, vi: bulletinVi }, lang) as any).weeks ?? 3),
  },
  office: OFFICE_HOURS[lang] ?? OFFICE_HOURS.en,
  emergencies: EMERGENCIES.map((e) => ({ label: emergencyLabel(e, lang), number: e.number })),
  contact: { phone: PHONE, email: EMAIL },
  staff: {
    members: staffMembers,
    assetUrl: (p: string) => p,
    profileHref: (slug: string) => `/${lang}/staff/${slug}/`,
    profileLabel: ui.viewProfile,
  },
});
const blocksHtml = (title: string, blocks: Array<any>) => {
  const list = blocks ?? [];
  if (!list.length) return '';
  const o = blockOpts(title);
  // Consecutive buttons share one row (side by side), exactly like the old
  // calendar buttons did; every other widget renders on its own via the
  // shared renderer. Buttons stay standard button blocks either way.
  let out = '';
  let i = 0;
  while (i < list.length) {
    const b = list[i];
    if (b?.type === 'button') {
      const run: Array<any> = [];
      while (i < list.length && list[i]?.type === 'button') run.push(list[i++]);
      const anchors = run.map((x) => {
        const label = (x.label || '').trim();
        const link = (x.link || '').trim();
        if (!label || !link) return '';
        return '<a class="' + btnClassFor(x.style) + '" href="' +
          esc(resolveLink(link, lang)) + '">' + esc(label) + '</a>';
      }).filter(Boolean).join('');
      if (anchors) out += '<p class="flex flex-wrap gap-2">' + anchors + '</p>';
    } else if (b?.type === 'card') {
      // Consecutive cards share one grid, exactly like page sections do —
      // one card per grid would stack them instead of sitting side by side.
      const run: Array<any> = [];
      while (i < list.length && list[i]?.type === 'card') run.push(list[i++]);
      if (run.length) {
        out += renderSections(
          [{ type: 'content_section', title: '', body: '', blocks: run }], o);
      }
    } else {
      out += renderSections(
        [{ type: 'content_section', title: '', body: '', blocks: [list[i++]] }], o);
    }
  }
  return out;
};
// Custom rows are fully generic sections: every card lives in blocks, so the
// row only picks how many columns the grids use (four restores the old
// four-across action-cards look).
const customBlocksHtml = (title: string, blocks: Array<any>, layout: string) => {
  const html = blocksHtml(title, blocks);
  return layout === 'four' ? html.replaceAll('class="cards"', 'class="cards four"') : html;
};
// Staff-composed sections (Sveltia: Homepage welcome → Sections): rows in
// display order with visibility toggles, plus custom blocks anywhere. Unknown
// ids ignored; missing sections appended visible in default position.
const DEFAULT_ORDER = ['carousel', 'hero', 'schedule', 'events', 'body', 'flocknote', 'catholic'];
const present = new Set(
  sections.flatMap((s) => {
    if (s?.type === 'preset' && typeof s.id === 'string') return [s.id];
    if (s?.type === 'hero' || s?.type === 'schedule' || s?.type === 'events' || s?.type === 'catholic') return [s.type];
    return [];
  }),
);
const ordered = [...sections];
for (const id of DEFAULT_ORDER) {
  if (!present.has(id)) {
    if (id === 'hero') ordered.push({ type: 'hero', visible: true });
    else if (id === 'schedule') ordered.push({ type: 'schedule', visible: true, buttons: [] });
    else if (id === 'events') ordered.push({ type: 'events', visible: true, events: [], facility: {} });
    else if (id === 'catholic') ordered.push({ type: 'catholic', visible: true, icons: [] });
    else ordered.push({ type: 'preset', id, visible: true });
  }
}
// Schedule buttons are staff-owned rows (CMS: Homepage Welcome & Events ->
// Schedule Block); Large keeps the old emphasized first-button look.
const scheduleBtnClass = (b: any) =>
  btnClassFor(b?.style) + (b?.size === 'large' ? ' px-8 text-lg' : '');
---
<Base lang={lang} slug="home" title={typeof titleVal === 'string' ? titleVal : ui.hero.welcome} fallback={false} canonicalPath={isRoot ? '/' : undefined}>
  {ordered.map((s, si) => (
    <>
      {s.type === 'custom' ? (
        <section aria-label={s.title || `Section ${si + 1}`}>
          {(s.title) && <h2>{s.title}</h2>}
          {customBlocksHtml(s.title || `Section ${si + 1}`, s.blocks, s.layout) && <div set:html={customBlocksHtml(s.title || `Section ${si + 1}`, s.blocks, s.layout)} />}
        </section>
      ) : s.visible === false ? null : (
      <>
      {s.id === 'carousel' && (<>
        <Carousel lang={lang} ui={ui} />
        {blocksHtml('Announcements', s.blocks) && <div set:html={blocksHtml('Announcements', s.blocks)} />}
      </>)}
      {s.type === 'hero' && (
        <section class="hero" aria-label="Welcome">
          {s.eyebrow ? <p class="hero-eyebrow">{s.eyebrow}</p> : null}
          <h1>{s.title || ui.hero.welcome}</h1>
          <p>{s.subtitle || ui.hero.subtitle}</p>
          <p class="pastor">{s.pastor_quote || ''}</p>
          <div class="mt-4 flex flex-wrap gap-2">
            {((s.buttons ?? []) as any[]).map((b) => (
              <a class={btnClassFor(b.style)} href={hrefFor(b.link)}>{b.label}</a>
            ))}
          </div>
          {blocksHtml(s.title || ui.hero.welcome, s.blocks) && <div set:html={blocksHtml(s.title || ui.hero.welcome, s.blocks)} />}
        </section>
      )}
      {s.type === 'schedule' && (
        <>
          <MassCards lang={lang} ui={ui} compact />
          {((s.buttons ?? []) as any[]).length > 0 && (
            <p class="mt-5 flex flex-wrap justify-start gap-2">
              {((s.buttons ?? []) as any[]).map((b) => (
                (b.label?.trim() && b.link?.trim()) ? (
                  <a class={scheduleBtnClass(b)} href={hrefFor(b.link.trim())}>{b.label.trim()}</a>
                ) : null
              ))}
            </p>
          )}
          {blocksHtml(ui.schedule.massTimes, s.blocks) && <div set:html={blocksHtml(ui.schedule.massTimes, s.blocks)} />}
        </>
      )}
      {s.type === 'events' && (
        <section aria-label="Events">
          <h2>{s.title || ui.eventsTitle}</h2>
          <div class="cards">
            {((s.events ?? []) as any[]).map((e) => (
              <article class="card">
                {e.icon ? <div class="card-head"><Icon name={e.icon} /><h3>{e.title}</h3></div> : <h3>{e.title}</h3>}
                <p>{e.text}{e.link ? <> <a href={hrefFor(e.link)}>{e.link_label}</a></> : null}</p>
              </article>
            ))}
          </div>
          {blocksHtml(s.title || ui.eventsTitle, s.blocks) && <div set:html={blocksHtml(s.title || ui.eventsTitle, s.blocks)} />}
        </section>
      )}
      {s.id === 'body' && body && (<>
        <section class="prose" data-pagefind-body>
          {fallback && <p class="fallback" data-fallback="en" role="note"><small>{ui.fallbackBanner}</small></p>}
          <div set:html={body} />
        </section>
        {blocksHtml(typeof titleVal === 'string' ? titleVal : ui.hero.welcome, s.blocks) && <div set:html={blocksHtml(typeof titleVal === 'string' ? titleVal : ui.hero.welcome, s.blocks)} />}
      </>)}
      {s.id === 'flocknote' && (<>
        <FlocknoteSignup ui={ui} lang={lang} />
        {blocksHtml(ui.stayTitle, s.blocks) && <div set:html={blocksHtml(ui.stayTitle, s.blocks)} />}
      </>)}
      {s.type === 'catholic' && (
        <section class="mb-2 mt-10 text-center" aria-label="Catholic links">
          <div class="flex flex-wrap items-end justify-center gap-10 md:gap-16">
            {((s.icons ?? []) as any[]).map((ic) => (
              ic.link?.trim() && hrefFor(ic.link.trim()) !== '#' ? (
                <a href={hrefFor(ic.link.trim())}><img src={ic.image} alt={ic.alt} width={ic.width || 140} height={ic.height || 140} loading="lazy" class="diocesan-icon" /></a>
              ) : (
                <img src={ic.image} alt={ic.alt} width={ic.width || 140} height={ic.height || 140} loading="lazy" class="diocesan-icon" />
              )
            ))}
          </div>
          {(((s as any).ethics_note || '').trim() ? (
            <div class="mx-auto mt-4 text-sm text-soft">
              <div set:html={renderMd(((s as any).ethics_note || '').trim())} />
              {(s as any).show_phone !== false && (
                <p><a href={`tel:${EXTERNAL.ethicspoint_phone.replace(/[^0-9]/g, '')}`} class="font-bold">{EXTERNAL.ethicspoint_phone}</a> · <a href={EXTERNAL.ethicspoint}>{(s as any).ethics_report || 'Report online'}</a></p>
              )}
            </div>
          ) : (
            <p class="mx-auto mt-4 text-sm text-soft">{(s as any).ethics_name}: {(s as any).show_phone !== false && (<><a href={`tel:${EXTERNAL.ethicspoint_phone.replace(/[^0-9]/g, '')}`} class="font-bold">{EXTERNAL.ethicspoint_phone}</a> · </>)}<a href={EXTERNAL.ethicspoint}>{(s as any).ethics_report}</a></p>
          ))}
          {blocksHtml('Catholic links', s.blocks) && <div set:html={blocksHtml('Catholic links', s.blocks)} />}
        </section>
      )}
      </>
      )}
    </>
  ))}
</Base>
