---
import Base from '../layouts/Base.astro';
import Carousel from './Carousel.astro';
import ActionCards from './ActionCards.astro';
import Icon from './Icon.astro';
import OfficeSection from './OfficeSection.astro';
import FlocknoteSignup from './FlocknoteSignup.astro';
import MassCards from './MassCards.astro';
import { EXTERNAL, resolveLink, type Lang } from '../config';
import homepageEn from '../data/homepage.en.json';
import homepageEs from '../data/homepage.es.json';
import homepageVi from '../data/homepage.vi.json';
import { pickLocale } from '../lib/i18n';
import { renderMd } from '../lib/md';
import en from '../data/ui.en.json';
import es from '../data/ui.es.json';
import vi from '../data/ui.vi.json';

interface Props {
  lang: Lang;
  home: { slug: string; en: any; es?: any; vi?: any } | undefined;
  /** Rendered at site root: canonical points to / instead of /en. */
  isRoot?: boolean;
}
const { lang, home: bundle, isRoot = false } = Astro.props;
const ui = lang === 'es' ? es : lang === 'vi' ? vi : en;
// Homepage copy falls back per-field exactly like topic pages do.
const homeEn = bundle?.en;
const homeLoc = (bundle as any)?.[lang] ?? homeEn;
const bodyEn = homeEn?.body ?? '';
const bodyLoc = (homeLoc?.body as string)?.trim();
const fallback = lang !== 'en' && !bodyLoc;
const body = renderMd(lang === 'en' ? bodyEn : (bodyLoc || bodyEn));
const titleVal = (homeLoc?.data?.title as string)?.trim()
  || homeEn?.data?.title || ui.hero.welcome;
const homepage = pickLocale({ en: homepageEn, es: homepageEs, vi: homepageVi }, lang) as any;
const pastorQuote: string = homepage.pastor_quote || '';
const events = (homepage.events as Array<any>) ?? [];
const hero = (homepage.hero as any) ?? {};
const heroButtons = (hero.buttons as Array<any>) ?? [];
const facility = (homepage.facility as any) ?? {};
const catholic = (homepage.catholic as any) ?? {};
const icons = (catholic.icons as Array<any>) ?? [];
const btnClassFor = (s: string) =>
  s === 'gold' ? 'btn btn-gold' : s === 'primary' ? 'btn btn-primary' : s === 'outline' ? 'btn btn-outline' : 'btn btn-light';
const hrefFor = (link: string) => resolveLink(link, lang);
// Staff-composed sections (Sveltia: Homepage welcome → Sections): theme rows in
// display order with visibility toggles, plus custom blocks anywhere. Unknown
// ids ignored; missing theme sections appended visible in default position.
const DEFAULT_ORDER = ['carousel', 'hero', 'actions', 'schedule', 'events', 'body', 'office', 'flocknote', 'catholic'];
const sections = (homepage.sections as Array<any>) ?? [];
const present = new Set(
  sections.filter((s) => s?.type === 'preset').map((s) => s.id),
);
const ordered = [...sections];
for (const id of DEFAULT_ORDER) {
  if (!present.has(id)) ordered.push({ type: 'preset', id, visible: true });
}
---
<Base lang={lang} slug="home" title={typeof titleVal === 'string' ? titleVal : ui.hero.welcome} fallback={false} canonicalPath={isRoot ? '/' : undefined}>
  {ordered.map((s, si) => (
    <>
      {s.type === 'custom' ? (
        <section aria-label={s.title || `Section ${si + 1}`}>
          {(s.title) && <h2>{s.title}</h2>}
          <div class="cards">
            {((Array.isArray(s.cards) ? s.cards : []) as any[]).map((c: any) => (
              <article class="card">
                {c.icon ? <div class="card-head"><Icon name={c.icon} /><h3>{c.title}</h3></div>
                : (c.title) ? <h3>{c.title}</h3> : null}
                {c.image?.trim() ? (c.link?.trim()
                  ? <p><a href={hrefFor(c.link.trim())}><img src={c.image} alt={c.title || ''} loading="lazy" style="border-radius:.5rem" /></a></p>
                  : <p><img src={c.image} alt={c.title || ''} loading="lazy" style="border-radius:.5rem" /></p>) : null}
                {(c.text) && <p>{c.text}</p>}
                {c.link?.trim() ? <p><a class="btn btn-outline" href={hrefFor(c.link.trim())}>{c.link_label || c.title}</a></p> : null}
              </article>
            ))}
          </div>
        </section>
      ) : s.visible === false ? null : (
      <>
      {s.id === 'carousel' && <Carousel lang={lang} ui={ui} />}
      {s.id === 'hero' && (
        <section class="hero" aria-label="Welcome">
          {hero.eyebrow ? <p class="hero-eyebrow">{hero.eyebrow}</p> : null}
          <h1>{hero.title || ui.hero.welcome}</h1>
          <p>{hero.subtitle || ui.hero.subtitle}</p>
          <p class="pastor">{pastorQuote}</p>
          <div class="mt-4 flex flex-wrap gap-2">
            {heroButtons.map((b) => (
              <a class={btnClassFor(b.style)} href={hrefFor(b.link)}>{b.label}</a>
            ))}
          </div>
        </section>
      )}
      {s.id === 'actions' && <ActionCards lang={lang} ui={ui} />}
      {s.id === 'schedule' && (
        <>
          <MassCards lang={lang} ui={ui} compact />
          <p class="mt-5 flex flex-wrap justify-start gap-2">
            <a class="btn btn-primary px-8 text-lg" href={`/${lang}/mass-times/`}>{ui.schedule.seeAll} →</a>
            <a class="btn btn-outline" href={EXTERNAL.youtube}>▶ {ui.schedule.stream}: @smgsjca</a>
          </p>
        </>
      )}
      {s.id === 'events' && (
        <section aria-label="Events">
          <h2>{ui.eventsTitle}</h2>
          <div class="cards">
            {events.map((e) => (
              <article class="card">
                {e.icon ? <div class="card-head"><Icon name={e.icon} /><h3>{e.title}</h3></div> : <h3>{e.title}</h3>}
                <p>{e.text}{e.link ? <> <a href={hrefFor(e.link)}>{e.link_label}</a></> : null}</p>
              </article>
            ))}
          </div>
          <p>{facility.tail}</p>
          <p class="flex flex-wrap gap-2">
            <a class="btn btn-primary" href={`/${lang}/calendar/#today`}>{ui.todayEvents}</a>
            <a class="btn btn-outline" href={`/${lang}/calendar/`}>{ui.fullCalendar}</a>
            <a class="btn btn-outline" href={EXTERNAL.calendarSuggest}>{facility.link_label}</a>
          </p>
        </section>
      )}
      {s.id === 'body' && body && (
        <section class="prose" data-pagefind-body>
          {fallback && <p class="fallback" data-fallback="en" role="note"><small>{ui.fallbackBanner}</small></p>}
          <div set:html={body} />
        </section>
      )}
      {s.id === 'office' && <OfficeSection lang={lang} ui={ui} />}
      {s.id === 'flocknote' && <FlocknoteSignup ui={ui} lang={lang} />}
      {s.id === 'catholic' && (
        <section class="mb-2 mt-10 text-center" aria-label="Catholic links">
          <div class="flex flex-wrap items-end justify-center gap-10 md:gap-16">
            {icons.map((ic) => (
              <a href={ic.link}><img src={ic.image} alt={ic.alt} width={ic.width || 140} height={ic.height || 140} loading="lazy" class="diocesan-icon" /></a>
            ))}
          </div>
          {((catholic.ethics_note || '').trim() ? (
            <div class="mx-auto mt-4 text-sm text-soft">
              <div set:html={renderMd((catholic.ethics_note || '').trim())} />
              {catholic.show_phone !== false && (
                <p><a href={`tel:${EXTERNAL.ethicspoint_phone.replace(/[^0-9]/g, '')}`} class="font-bold">{EXTERNAL.ethicspoint_phone}</a> · <a href={EXTERNAL.ethicspoint}>{catholic.ethics_report || 'Report online'}</a></p>
              )}
            </div>
          ) : (
            <p class="mx-auto mt-4 text-sm text-soft">{catholic.ethics_name}: {catholic.show_phone !== false && (<><a href={`tel:${EXTERNAL.ethicspoint_phone.replace(/[^0-9]/g, '')}`} class="font-bold">{EXTERNAL.ethicspoint_phone}</a> · </>)}<a href={EXTERNAL.ethicspoint}>{catholic.ethics_report}</a></p>
          ))}
        </section>
      )}
      </>
      )}
    </>
  ))}
</Base>
