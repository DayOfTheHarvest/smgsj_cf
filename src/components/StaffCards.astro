---
import staffEn from '../data/staff.en.json';
import staffEs from '../data/staff.es.json';
import staffVi from '../data/staff.vi.json';
import { pickLocale } from '../lib/i18n';
interface Props { lang: string; ui: any; }
const { lang, ui } = Astro.props;
const members = ((pickLocale({ en: staffEn, es: staffEs, vi: staffVi }, lang as any) as any).members as Array<{
  slug: string; name: string; role: string; phone: string; photo: string; bio: string;
}>) ?? [];
const initials = (name: string) =>
  name.replace(/^(Rev\.|Mrs?\.|Ms\.|Sr\.|Deacon)\s+/i, '').split(/\s+/).map((w) => w[0]).slice(0, 2).join('').toUpperCase();
---
<div class="cards staff-grid">
  {members.map((s) => (
    <article class="card staff-card">
      {s.photo ? (
        <img class="staff-photo" src={s.photo} alt={s.name} width="160" height="160" loading="lazy" />
      ) : (
        <span class="staff-initials" aria-hidden="true">{initials(s.name)}</span>
      )}
      <h3>{s.name}</h3>
      <p class="staff-role">{s.role}</p>
      <p class="my-1"><a href={`tel:${s.phone.replace(/[^0-9]/g, '')}`}>{s.phone}</a></p>
      {s.bio ? (
        <p class="my-1">
          <a class="btn btn-outline" href={`/${lang}/staff/${s.slug}/`}>{ui.viewProfile}</a>
        </p>
      ) : null}
    </article>
  ))}
</div>
